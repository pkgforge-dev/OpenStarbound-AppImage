#!/bin/sh

if [ ${ARG0##*/} == "$MAIN_BIN" ]; then
    if [ -f "$APPDIR"/bin/"${ARG0##*/}" ]; then
        set -- -bootconfig "${CONFIGDIR}/starbound/sbinit.config" "$@"
    fi
elif [ "$1" = "$MAIN_BIN" ]; then
    if [ -f "$APPDIR"/bin/"$1" ]; then
        set -- -bootconfig "${CONFIGDIR}/starbound/sbinit.config" "$@"
    fi
fi
